{
  "name": "destiny2-arsenal",
  "version": "1.0.0",
  "description": "Local Destiny 2 Arsenal & Perk Explorer web application",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"cyan,amber\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "deploy:ci": "npx wrangler pages deploy dist --project-name=destiny2-arsenal",
    "start": "node server/index.js",
    "sync": "node -e \"require('./server/manifest-service').syncManifest('', true)\""
  },
  "keywords": [
    "destiny2",
    "bungie",
    "armory",
    "perk-finder",
    "god-rolls",
    "weapons",
    "armor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.8.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "vite": "^8.2.2"
  }
}
